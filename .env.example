# Postgres connection string (Neon: use the "Direct"/unpooled URL so migrations work)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Auth
BETTER_AUTH_SECRET=change-me-to-a-long-random-string   # e.g. openssl rand -base64 32
BETTER_AUTH_URL=https://your-project.vercel.app

# Email (optional - welcome emails are skipped if empty)
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# App
NEXT_PUBLIC_APP_NAME=Property Maintenance
APP_TIMEZONE=Asia/Hebron
APP_DEFAULT_LOCALE=ar
